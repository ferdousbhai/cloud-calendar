# Maintainer: Ferdous Bhai <23114244+ferdousbhai@users.noreply.github.com>
pkgname=cloud-calendar
pkgver=0.3.0
pkgrel=1
pkgdesc="Your iCloud, Google and HEY calendars in one place on Omarchy (CLI + GTK app)"
arch=('x86_64' 'aarch64')
url="https://github.com/ferdousbhai/cloud-calendar"
license=('MIT')
depends=('gtk4' 'glib2' 'gcc-libs' 'glibc')
makedepends=('cargo' 'git')
checkdepends=('bash' 'dbus')
options=('!debug' '!lto')  # makepkg's C LTO breaks ring's assembly objects
optdepends=(
  'icloud-session: iCloud calendars, through the iCloud sign-in your other iCloud apps share'
  'npm: Google'\''s Workspace CLI (gws) for a Google Calendar account'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')  # pin the tag archive's checksum when releasing

_srcdir() { echo "$srcdir/cloud-calendar-$pkgver"; }

prepare() {
  cd "$(_srcdir)"
  cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
  cd "$(_srcdir)"
  export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-target}"
  cargo build --frozen --release -p cloud-calendar -p cloud-calendar-gtk
}

check() {
  cd "$(_srcdir)"
  export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-target}"
  cargo test --frozen --workspace
}

package() {
  cd "$(_srcdir)"
  install -Dm755 "${CARGO_TARGET_DIR:-target}/release/cloud-calendar" "$pkgdir/usr/bin/cloud-calendar"
  # One name: `cloud-calendar open` runs the window's binary, which is the CLI's helper rather than a command of its own.
  install -Dm755 "${CARGO_TARGET_DIR:-target}/release/cloud-calendar-gtk" "$pkgdir/usr/lib/cloud-calendar/cloud-calendar-gtk"
  # The old command, for key bindings and older notifications that still run it; it runs `cloud-calendar open`.
  install -Dm755 packaging/compat/cloud-calendar-gtk "$pkgdir/usr/bin/cloud-calendar-gtk"
  install -Dm644 crates/cloud-calendar-gtk/data/cloud-calendar.desktop \
    "$pkgdir/usr/share/applications/cloud-calendar.desktop"
  install -Dm644 crates/cloud-calendar-gtk/data/cloud-calendar.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/cloud-calendar.svg"
  install -Dm644 -t "$pkgdir/usr/lib/systemd/user" \
    packaging/systemd/cloud-calendar-notify.service packaging/systemd/cloud-calendar-notify.timer
  install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE THIRD_PARTY_NOTICES.md
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
