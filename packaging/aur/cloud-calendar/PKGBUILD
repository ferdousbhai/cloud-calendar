# Maintainer: Ferdous Bhai <23114244+ferdousbhai@users.noreply.github.com>
pkgname=cloud-calendar
pkgver=0.1.0
pkgrel=1
pkgdesc="Your iCloud, Google and HEY calendars in one place on Omarchy (CLI + GTK app)"
arch=('x86_64' 'aarch64')
url="https://github.com/ferdousbhai/cloud-calendar"
license=('MIT')
depends=('gtk4' 'glib2' 'gcc-libs' 'glibc')
makedepends=('cargo' 'git')
checkdepends=('bash' 'dbus')
options=('!debug' '!lto')  # makepkg's C LTO breaks ring's assembly objects
optdepends=(
  'icloud-session: iCloud calendars, through the iCloud sign-in your other iCloud apps share'
  'gnome-keyring: a keyring (Secret Service) for a Google account'\''s OAuth client secret'
  'npm: Google'\''s Workspace CLI (gws) for a Google Calendar account'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')  # pin the tag archive's checksum when releasing

_srcdir() { echo "$srcdir/cloud-calendar-$pkgver"; }

prepare() {
  cd "$(_srcdir)"
  cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
  cd "$(_srcdir)"
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release -p cloud-calendar -p cloud-calendar-gtk
}

check() {
  cd "$(_srcdir)"
  export CARGO_TARGET_DIR=target
  cargo test --frozen --workspace
}

package() {
  cd "$(_srcdir)"
  install -Dm755 target/release/cloud-calendar "$pkgdir/usr/bin/cloud-calendar"
  install -Dm755 target/release/cloud-calendar-gtk "$pkgdir/usr/bin/cloud-calendar-gtk"
  install -Dm644 crates/cloud-calendar-gtk/data/com.ferdousbhai.CloudCalendar.desktop \
    "$pkgdir/usr/share/applications/com.ferdousbhai.CloudCalendar.desktop"
  install -Dm644 crates/cloud-calendar-gtk/data/com.ferdousbhai.CloudCalendar.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/com.ferdousbhai.CloudCalendar.svg"
  install -Dm644 -t "$pkgdir/usr/lib/systemd/user" \
    packaging/systemd/cloud-calendar-notify.service packaging/systemd/cloud-calendar-notify.timer
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
