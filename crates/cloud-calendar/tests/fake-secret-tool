#!/usr/bin/env bash
# A stand-in for libsecret's `secret-tool`: keeps secrets in $FAKE_SECRET_DIR, one file per
# attribute set.
dir="${FAKE_SECRET_DIR:?}"; mkdir -p "$dir"
cmd=$1; shift
if [[ "$cmd" == "store" ]]; then shift 2; fi   # --label <label>
key=$(printf '%s_' "$@" | tr -c 'A-Za-z0-9_.@-' '_')
case "$cmd" in
  store) cat > "$dir/$key" ;;
  lookup) [[ -f "$dir/$key" ]] || exit 1; cat "$dir/$key" ;;
  clear) rm -f "$dir"/*"account_$4_"* ;;
esac
