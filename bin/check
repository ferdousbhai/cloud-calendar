#!/bin/bash
# Every check a change must pass, run on this machine. .githooks/pre-push runs it before a push
# (NO_CHECK=1 skips it); enable the hook once per clone with `git config core.hooksPath .githooks`.
set -euo pipefail
cd "$(dirname "$0")/.."
export PATH="$HOME/.cargo/bin:$PATH"

# Validate vendored support before the more expensive product checks.
python3 bin/check-shared-support

step() { printf '\n==> %s\n' "$*"; }

# The desktop app needs GTK 4; without it only the CLI and the library are checked.
crates=(--workspace)
gtk=1
if ! pkg-config --exists gtk4 2>/dev/null; then
  echo "note: skipping cloud-calendar-gtk (install gtk4 to check it)" >&2
  crates+=(--exclude cloud-calendar-gtk)
  gtk=0
fi

step "rustfmt (fix with: cargo fmt --all)"
cargo fmt --all -- --check
step "clippy"
cargo clippy --locked "${crates[@]}" --all-targets -- -D warnings
step "cargo test"
cargo test --locked "${crates[@]}"

if ((gtk)); then
  # The app driven through its views, the editor and Accounts on the stand-in accounts, on a private broadway
  # display; any GTK warning fails it. Only this build has omui's QA in it.
  step "app QA (dev/qa)"
  cargo build --locked -p cloud-calendar-gtk --features qa
  dev/qa.sh "${CARGO_TARGET_DIR:-target}/debug/cloud-calendar-gtk" dev/qa/*.jsonl
fi

step "packaging"
bash packaging/repo/test.sh
python3 packaging/repo/test_arch.py
bash -n bin/arch-run packaging/aur/cloud-calendar/PKGBUILD bin/build-package bin/release bin/verify-release .githooks/pre-push dev/preview.sh dev/qa.sh

printf '\nAll checks passed.\n'
