#!/bin/bash
# Verify exactly one published release on its native architecture. No automatic deletion.
set -euo pipefail
version=${1:?usage: bin/verify-release <version> [x86_64|aarch64]}
[[ $version =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo 'Invalid version' >&2; exit 1; }
arch=${2:-$(uname -m)}
case "$arch" in x86_64|aarch64) ;; *) echo "Unsupported architecture: $arch" >&2; exit 1 ;; esac
[[ $(uname -m) == "$arch" ]] || { echo 'A native runner is required.' >&2; exit 1; }
cd "$(dirname "$0")/.."
releases=https://github.com/ferdousbhai/cloud-calendar/releases/download/v$version
exec bin/arch-run env EXPECTED_VERSION="$version" EXPECTED_ARCH="$arch" \
  CLOUD_CALENDAR_RELEASES_URL="$releases" bash -euo pipefail -c '
    [[ $(uname -m) == "$EXPECTED_ARCH" ]]
    curl --fail --location --retry 3 "$CLOUD_CALENDAR_RELEASES_URL/install.sh" -o /tmp/install.sh
    bash /tmp/install.sh
    [[ $(pacman -Q cloud-calendar | cut -d" " -f2) == "$EXPECTED_VERSION-1" ]]
    [[ $(cloud-calendar --version) == "cloud-calendar $EXPECTED_VERSION" ]]
    test -x /usr/bin/cloud-calendar-gtk
    ldd /usr/bin/cloud-calendar-gtk > /tmp/gtk-libraries
    ! grep -q "not found" /tmp/gtk-libraries
    test -f /usr/lib/systemd/user/cloud-calendar-notify.timer
  '
