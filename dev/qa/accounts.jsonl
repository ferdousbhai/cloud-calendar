# The Accounts window on the stand-in accounts: each one's state, removing one, and the two ways out. dev/qa.sh runs it
# (bin/check runs all). Sign in and the add buttons are not pressed: they open a browser or iCloud's sign-in.
{"do":"wait","role":"label","name":"iCloud: icloud-session failed (Failed to connect to address `unix:path=/nonexistent`: No such file or directory (os error 2))","visible":true}
{"do":"click","role":"button","name":"Manage accounts"}
{"do":"wait","role":"window","name":"Accounts","visible":true}
{"do":"wait","role":"label","name":"✓ Google (google)","visible":true}
{"do":"wait","role":"label","name":"✓ HEY (hey)","visible":true}
{"do":"wait","role":"label","name":"✗ iCloud (icloud)","visible":true}
# Each row's two buttons read alike; the name a screen reader says first is the account's own.
{"do":"focus","role":"button","name":"Sign in to icloud again"}
{"do":"wait","focus":{"role":"button","name":"Sign in to icloud again"}}
# iCloud's failure takes several lines; its buttons stay the height of any other, which is 24 at omui's font here.
{"do":"wait","role":"button","name":"HEY","sensitive":true,"height":24}
{"do":"wait","role":"button","name":"Sign in to icloud again","sensitive":true,"height":24}
{"do":"wait","role":"button","name":"Remove icloud","height":24}
{"do":"key","keys":"Escape"}
{"do":"wait","role":"window","name":"Accounts","visible":false}

# Remove asks again on its own button, then the account goes from the list and its warning from the week.
{"do":"click","role":"button","name":"Manage accounts"}
{"do":"click","role":"button","name":"Remove icloud"}
{"do":"wait","focus":{"role":"button","name":"Really remove icloud?"}}
{"do":"wait","role":"button","name":"Remove hey","visible":true}
{"do":"click","role":"button","name":"Really remove icloud?"}
{"do":"wait","role":"label","name":"✗ iCloud (icloud)","visible":false}
{"do":"wait","role":"label","name":"✓ HEY (hey)","visible":true}
# The window's own Close. Its title bar has a Close too, and no name or ancestor tells the two apart, so this one is
# reached as the keyboard reaches it: it is the stop after the add buttons.
{"do":"focus","role":"button","name":"HEY"}
{"do":"key","keys":"Tab"}
{"do":"wait","focus":{"role":"button","name":"Close"}}
{"do":"key","keys":"Return"}
{"do":"wait","role":"window","name":"Accounts","visible":false}
{"do":"wait","role":"label","name":"iCloud: icloud-session failed (Failed to connect to address `unix:path=/nonexistent`: No such file or directory (os error 2))","visible":false}
{"do":"shot","path":"accounts-removed.png"}
{"do":"quit"}
